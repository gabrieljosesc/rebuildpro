# Copy to .env.local and fill in.

# Public site URL, no trailing slash
NEXT_PUBLIC_SITE_URL=https://rebuildprocontracting.ca

# Supabase (quote form + photo uploads)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Tracking (leave blank to disable)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_LEAD_LABEL=
NEXT_PUBLIC_GADS_CALL_LABEL=

# Search Console / Bing Webmaster Tools verification codes
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
